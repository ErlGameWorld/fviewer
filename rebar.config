{erl_opts, [
   {i, "include"}
   , no_debug_info
   , deterministic
   , warn_export_vars
   , warn_shadow_vars
   , warn_obsolete_guard
   , warn_untyped_record
]}.

{deps, [{eWSrv, ".*", {git, "https://github.com/ErlGameWorld/eWSrv.git", {branch, "main"}}}]}.

{shell, [
    {apps, [fviewer]}
]}.

%% == Escript Configuration ==
%% Fixed node name prevents starting two instances (duplicate name clash).
{escript_main_app, fviewer}.
{escript_name, "fviewer"}.
{escript_incl_apps, [eWSrv, eNet]}.
{escript_emu_args, "%%! +sbtu +A0 -sname fviewer -setcookie fviewer -detached\n"}.

{provider_hooks, [
    {pre, [{escriptize, {default, compile}}]}
]}.

%% Build / embed frontend before compile & escriptize.
%% Skip with: set FVIEWER_SKIP_FRONTEND=1
%% Arch regex must match erlang:system_info(system_architecture),
%% e.g. x86_64-pc-windows / x86_64-apple-darwin / x86_64-pc-linux-gnu
{pre_hooks, [
    {compile, "node scripts/rebar_frontend_hook.mjs"},
    {escriptize, "node scripts/rebar_frontend_hook.mjs"}
]}.
